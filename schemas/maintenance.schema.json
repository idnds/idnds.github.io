{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "typeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "vendorId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "productIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "publishedAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "summaryMd": {
      "type": "string",
      "minLength": 1
    },
    "detailsMd": {
      "default": "",
      "type": "string"
    },
    "customerActionMd": {
      "type": "string"
    },
    "impact": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "downtime",
          "limited-availability",
          "action-required"
        ]
      }
    },
    "relations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "relates-to",
              "resolves",
              "follow-up-to",
              "supersedes"
            ]
          },
          "eventId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "eventId"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "active",
        "cancelled"
      ]
    },
    "eventDate": {
      "type": "string"
    },
    "endDate": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "slug",
    "typeId",
    "vendorId",
    "productIds",
    "title",
    "publishedAt",
    "summaryMd",
    "impact",
    "relations",
    "status",
    "eventDate",
    "endDate"
  ],
  "additionalProperties": false
}